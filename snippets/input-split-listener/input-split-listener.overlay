/{
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pointing_device_split: pointing_device_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /* Helix: 左手のボール＝スクロール（11/12 田上さん指定）。
     * カーソルなら SWAP|X_INVERT が正しい向き（11/12 実機で確認）。スクロールはそこから縦だけ反転（右手と同じ関係）。 */
    pointing_device_split_listener: pointing_device_split_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device_split>;
        status = "okay";
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_to_scroll_mapper
            &zip_scroll_snap
            &zip_scroll_scaler 1 8
        >;
    };
};
