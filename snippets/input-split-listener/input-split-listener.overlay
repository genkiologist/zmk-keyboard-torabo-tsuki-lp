/{
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pointing_device_split: pointing_device_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /* Helix: 左手のボール＝スクロール。ケースは右手の鏡写しなのでセンサーは180度回った向き（X・Yとも反転、未実測） */
    pointing_device_split_listener: pointing_device_split_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device_split>;
        status = "okay";
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT)   // 右手のスクロール（Y反転）に、左右反転（X・Y反転）を重ねた結果
            &zip_xy_to_scroll_mapper
            &zip_scroll_snap
            &zip_scroll_scaler 1 8
        >;
    };
};
