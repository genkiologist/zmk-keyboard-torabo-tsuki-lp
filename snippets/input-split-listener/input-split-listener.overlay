/{
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pointing_device_split: pointing_device_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /* Helix: 左手のボール＝カーソル移動。向きは右手と同じ設定（11/12 田上さん指定）。
     * ケースが右の鏡写しなので、ずれていたらここの transform だけ直す。 */
    pointing_device_split_listener: pointing_device_split_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device_split>;
        status = "okay";
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)
            &zip_temp_layer 1 100000
        >;

        scroller {
            layers = <3>;
            input-processors = <
                &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)
                &zip_xy_to_scroll_mapper
                &zip_scroll_snap
                &zip_scroll_scaler 1 8
            >;
        };
    };
};
