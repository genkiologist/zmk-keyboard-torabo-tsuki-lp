#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "torabo_tsuki_lp_layouts.dtsi"

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left &encoder_right>;
        triggers-per-rotation = <15>;   /* Helix: SIQ-02FVS3 15クリック/回転 */
    };
};

/ {
    chosen {
        zmk,physical-layout = &physical_layout_xs;
        zmk,kscan = &kscan0;
        zmk,battery = &non_lipo_battery;
    };

    /* Helix rev3 5行版（60キー）: 行0=数字の段、行1〜3=文字、行4=親指。各行とも外側の列を含む6キー。
     * 最下段の内側1つ（左=Bの右下 RC(4,6)、右=Nの左下 RC(4,7)）は使わない。 */
    size_xs_transform: keymap_transform_3 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)          RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)          RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)          RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)          RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)          RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };

    /* Helix rev3 のキーマトリクス（ZMK 本体 helix シールドと同じ）。列は左右の overlay で指定 */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        wakeup-source;
    };
    
    encoder_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* Helix: A=B6 */
        b-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;    /* Helix: B=B5 */
        steps = <60>;   /* Helix: SIQ-02FVS3 15パルス×4 */
        status = "disabled";
    };

    encoder_right: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;    /* Helix beta: A=OLEDのSDA(PD1, P0.18) */
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;    /* Helix beta: B=OLEDのSCL(PD0, P0.16) */
        steps = <60>;   /* Helix: SIQ-02FVS3 15パルス×4 */
        status = "disabled";
    };

    leds {
        compatible = "gpio-leds";
        status_led: status_led {
            gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;   /* Helix: 追加IO 43 (P1.11) */
            label = "Status LED";
        };
    };

    status_led_device: status_led_device {
        compatible = "zmk,status-led";
        led = <&status_led>;
    };

    bootloader_trigger: bootloader_trigger {
        compatible = "zmk,cdc-acm-bootloader-trigger";
    };

    pointing_listener: pointing_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };

    // central側でのみ有効化する(zmk-input-processor-scroll-inertiaはcentral限定のため)
    scroll_inertia: scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        status = "disabled";

        axis = <0>;
        layer = <3>;

        scale = <1>;
        scale-div = <8>;
    };

    vbatt: vbatt {
        // Disable default battery monitoring
        status = "disabled";
    };
    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 4>; 
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 21)>,   /* Helix: SCLK=P0.21 */
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,  /* Helix: SDIO=P0.17 */
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 21)>,   /* Helix: SCLK=P0.21 */
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,  /* Helix: SDIO=P0.17 */
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
        low-power-enable;
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 18)>,
                    <NRF_PSEL(TWIM_SCL, 0, 16)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 18)>,
                    <NRF_PSEL(TWIM_SCL, 0, 16)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

&physical_layout_xs {
    compatible = "zmk,physical-layout";
    display-name = "XS Layout";
    kscan = <&kscan0>;
    transform = <&size_xs_transform>;
};
